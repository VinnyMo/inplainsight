[Unit]
Description=InPlainSight - Post-Quantum Steganographic File Encryption
After=network.target

[Service]
Type=simple
User=maestro
WorkingDirectory=/home/maestro/inplainsight
ExecStart=/home/maestro/.nvm/versions/node/v20.19.3/bin/node /home/maestro/inplainsight/server/server.js
Restart=on-failure
RestartSec=10

# Environment
Environment=NODE_ENV=production

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inplainsight

[Install]
WantedBy=multi-user.target
